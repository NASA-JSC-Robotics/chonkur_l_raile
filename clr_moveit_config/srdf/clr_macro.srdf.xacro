      <disable_collisions link1="${tf_prefix}finger_1_link" link2="${tf_prefix}ur_realsense_mount" reason="Never"/>
      <disable_collisions link1="${tf_prefix}finger_2_link" link2="${tf_prefix}gripper_base_link" reason="Adjacent"/>
