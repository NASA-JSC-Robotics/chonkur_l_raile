      <disable_collisions link1="${tf_prefix}ewellix_lift_higher_link" link2="${tf_prefix}vention_rail_cable_collision" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_higher_link" link2="${tf_prefix}vention_rail_carriage" reason="Never"/>
