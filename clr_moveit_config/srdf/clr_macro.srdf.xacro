      <disable_collisions link1="${tf_prefix}finger_1_link" link2="${tf_prefix}wrist_1_link" reason="Never"/>
      <disable_collisions link1="${tf_prefix}finger_1_link" link2="${tf_prefix}wrist_2_link" reason="Never"/>
