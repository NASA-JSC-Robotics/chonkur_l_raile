      <disable_collisions link1="${tf_prefix}ewellix_lift_higher_link" link2="${tf_prefix}lift_camera_mount" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}ewellix_lift_middle_link" reason="Default"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}lower_lift_plate" reason="Adjacent"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}lift_camera_mount" reason="Adjacent"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}right_angle_mount" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}shoulder_link" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}upper_lift_plate" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}ur10e_mount_plate" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}vention_rail_base_link" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}vention_rail_cable_collision" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}vention_rail_carriage" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}vention_rail_gearbox" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}vention_rail_motor" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_lower_link" link2="${tf_prefix}lift_camera_mount" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}lower_lift_plate" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}right_angle_mount" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}shoulder_link" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}upper_lift_plate" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}ur10e_mount_plate" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}vention_rail_base_link" reason="Never"/>
      <disable_collisions link1="${tf_prefix}ewellix_lift_middle_link" link2="${tf_prefix}vention_rail_cable_collision" reason="Never"/>
