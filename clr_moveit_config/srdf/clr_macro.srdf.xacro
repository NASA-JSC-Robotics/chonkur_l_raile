      <disable_collisions link1="${tf_prefix}finger_1_link" link2="${tf_prefix}finger_2_link" reason="Default"/>
      <disable_collisions link1="${tf_prefix}finger_1_link" link2="${tf_prefix}gripper_base_link" reason="Adjacent"/>
      <disable_collisions link1="${tf_prefix}finger_1_link" link2="${tf_prefix}mtc_effector_side" reason="Never"/>
