<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="endeff_stack" params="
        tf_prefix
        parent
        *origin
        use_camera_mesh:=true
    ">

    <joint name="${tf_prefix}endeff_stack_base_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${tf_prefix}mtc_robot_side"/>
        <xacro:insert_block name="origin"/>
    </joint>

    <link name="${tf_prefix}mtc_robot_side">
        <visual>
            <geometry>
                <mesh filename= "package://chonkur_description/meshes/visual/mtc_robot_side.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.0184" radius="0.0525" />
            </geometry>
            <origin xyz="0 0 0.0092" rpy="0 0 0" />
        </collision>
        <!-- Measured mass -->
        <inertial>
            <origin rpy="-2.3020013e-03 -3.3700999e-03  7.3028674e-03" xyz="0.0 0.0 0.0"/>
            <mass value="0.234"/>
            <inertia ixx="0.00012689626" ixy="0.0000022170518" ixz="0.0000023900060" iyy="0.000090492203" iyz="0.00000093596408" izz="0.00020810513" />
      </inertial>
    </link>

    <joint name="${tf_prefix}mtc_robot_to_effector_side_joint" type="fixed">
        <parent link="${tf_prefix}mtc_robot_side"/>
        <child link="${tf_prefix}mtc_effector_side"/>
        <origin xyz="0 0 0.008763" rpy="0 0 0"/>
    </joint>

    <link name="${tf_prefix}mtc_effector_side">
        <visual>
            <geometry>
                <mesh filename= "package://chonkur_description/meshes/visual/mtc_effector_side.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.0237" radius="0.0525" />
            </geometry>
            <origin xyz="0 0 0.01185" rpy="0 0 0" />
        </collision>
        <!-- Measured mass -->
        <inertial>
            <origin rpy="2.7996999e-03  3.0073601e-04  1.2016667e-02" xyz="0.0 0.0 0.0"/>
            <mass value="0.173"/>
            <inertia ixx="0.000046537307" ixy="0.000000049279921" ixz="0.0000031354081" iyy="0.000068895878" iyz="0.00000054211975" izz="0.000097074288" />
        </inertial>
    </link>

    <joint name="${tf_prefix}mtc_effector_side_to_realsense_mount" type="fixed">
        <parent link="${tf_prefix}mtc_effector_side"/>
        <child link="${tf_prefix}ur_realsense_mount"/>
        <origin xyz="0 0 0.023684" rpy="0 0 ${radians(180)}"/>
    </joint>

    <link name="${tf_prefix}ur_realsense_mount">
        <visual>
            <geometry>
                <mesh filename= "package://chonkur_description/meshes/visual/ur_realsense_short_mount_tube.stl"/>
            </geometry>
            <material name="${tf_prefix}ur_realsense_mount">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename= "package://chonkur_description/meshes/visual/ur_realsense_short_mount_tube.stl"/>
            </geometry>
        </collision>
        <!-- Mass is estimated. Combined mass of ur_realsense_mount and robotiq_hande_adapter is 269.5 g -->
        <inertial>
            <origin rpy="-2.5671055e-02 -2.9268392e-02 -2.7874570e-04" xyz="0.0 0.0 0.0"/>
            <mass value="0.0521"/>
            <inertia ixx="1.6417524e-04" ixy="4.7936307e-05" ixz="4.1938251e-06" iyy="1.0429851e-04" iyz="-2.1690756e-06" izz="2.6710819e-04" />
        </inertial>
    </link>

    <!-- Realsense camera -->
    <xacro:property name="realsense_materials_defined" value="true" />
    <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
    <xacro:sensor_d435 parent="${tf_prefix}ur_realsense_mount" use_nominal_extrinsics="true" use_mesh="${use_camera_mesh}" name="${tf_prefix}wrist_mounted_camera">
        <origin xyz="-0.064 -0.003 0.016" rpy="0.136 -1.429 -0.128"/>
    </xacro:sensor_d435>

    </xacro:macro>
</robot>
